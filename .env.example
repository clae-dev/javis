# OpenAI
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
FAST_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
STT_MODEL=gpt-4o-mini-transcribe
# 받아쓰기를 이 기계에서 하려면 local (네트워크 왕복 없음, 첫 실행 때 모델 다운로드)
STT_ENGINE=openai
STT_LOCAL_MODEL=small
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# 웹 검색 (없으면 ddgs 무료 폴백 사용)
TAVILY_API_KEY=

# Database (Docker compose 사용 시 자동 주입됨. 로컬 실행 시에만 수정)
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis
DB_PASSWORD=jarvis

# 비서 인격 / 로캘
ASSISTANT_NAME=자비스
OWNER_NAME=창래
TIMEZONE=Asia/Seoul

# 접속 토큰. 비우면 인증 없이 열린다(로컬 단독 실행용).
# 폰이나 다른 기기에서 붙을 거라면 반드시 채운다. 예: python -c "import secrets;print(secrets.token_urlsafe(32))"
JAVIS_TOKEN=

# 동작 토글
USE_POSTGRES_CHECKPOINTER=true
ENABLE_SCHEDULER=true

# Google (선택)
GOOGLE_CREDENTIALS_PATH=credentials/google.json
GOOGLE_TOKEN_PATH=credentials/token.json

# Claude Code 연동 — 음성으로 코드 조회·수정 (선택)
# claude CLI 가 설치돼 있어야 하고, 여기 등록한 프로젝트만 열 수 있다.
# 백엔드가 claude 를 실행해야 하므로 Docker 안이 아니라 호스트에서 띄워야 한다(README 참고).
# 말로 부르는 이름이 폴더명과 다르면 `|` 로 별칭을 여러 개 단다.
CODE_PROJECTS=javis|자비스=C:\workspace\Javis
CODE_MODEL=opus
# 응답이 느리면: CODE_MODEL=sonnet

# 음성 데몬 웨이크워드 (openWakeWord, 무료·키 불필요). "헤이 자비스 / hey jarvis"로 깸.
# 끄려면 JAVIS_OWW=0 (그러면 Vosk 방식). 임계값 0~1, 높을수록 엄격(오인식↓, 기본 0.5).
JAVIS_OWW=1
JAVIS_OWW_THRESHOLD=0.5

# 음성 데몬 — 답변 뒤 이만큼(초) 동안은 깨우지 않고 이어 말할 수 있다. 0 이면 끔.
JAVIS_CONV_TIMEOUT=10
# 첫 덩어리를 로컬 음성(SAPI)으로 즉시 내보내 첫 소리까지의 지연을 없앤다. 끄려면 0.
JAVIS_TTS_FIRST_LOCAL=1
# 운전 모드 — 답변을 두세 문장으로 줄인다.
JAVIS_DRIVE=0
