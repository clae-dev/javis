# OpenAI
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
FAST_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
STT_MODEL=gpt-4o-mini-transcribe
# 받아쓰기를 이 기계에서 하려면 local (네트워크 왕복 없음, 첫 실행 때 모델 다운로드)
STT_ENGINE=openai
STT_LOCAL_MODEL=small
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# 웹 검색 (없으면 ddgs 무료 폴백 사용)
TAVILY_API_KEY=

# Database (Docker compose 사용 시 자동 주입됨. 로컬 실행 시에만 수정)
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis
DB_PASSWORD=jarvis

# 비서 인격 / 로캘
ASSISTANT_NAME=자비스
OWNER_NAME=창래
TIMEZONE=Asia/Seoul

# 접속 토큰. 비우면 인증 없이 열린다(로컬 단독 실행용).
# 폰이나 다른 기기에서 붙을 거라면 반드시 채운다. 예: python -c "import secrets;print(secrets.token_urlsafe(32))"
JAVIS_TOKEN=

# 동작 토글
USE_POSTGRES_CHECKPOINTER=true
ENABLE_SCHEDULER=true

# Google (선택)
GOOGLE_CREDENTIALS_PATH=credentials/google.json
GOOGLE_TOKEN_PATH=credentials/token.json

# 필립스 휴 (선택) — 브리지 버튼 누르고 `python scripts/hue_auth.py` 한 번 실행
# HUE_BRIDGE_IP 를 비우면 discovery.meethue.com 으로 알아서 찾는다.
HUE_BRIDGE_IP=
HUE_APP_KEY=

# 안드로이드폰 (선택) — 개발자 옵션에서 USB 디버깅을 켜고 케이블로 연결하거나,
# 무선 디버깅을 켠 뒤 `adb connect <폰IP>:5555`.
# adb 가 PATH 에 없으면 실행 파일 경로를 적는다. 기기가 여럿이면 ANDROID_SERIAL 로 고정.
ANDROID_ADB_PATH=
ANDROID_SERIAL=
# 문자를 보내기까지 할지. 기본(false)은 메시지 앱에 채워만 두고 전송은 사람이 누른다.
ANDROID_SMS_AUTOSEND=false

# 브라우저 자동화 (선택) — `python -m playwright install chromium` 한 번 필요.
# 로그인 세션이 이 폴더에 남으므로 공유하지 말 것.
BROWSER_USER_DATA_DIR=credentials/browser
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30

# 유튜브 데이터 API (선택) — Cloud Console 에서 YouTube Data API v3 켜고 API 키 발급
YOUTUBE_API_KEY=

# 카카오 지도 (선택) — developers.kakao.com 에서 앱 만들고 REST API 키 발급.
# 길찾기(카카오모빌리티)는 별도 신청이 필요할 수 있다.
KAKAO_REST_API_KEY=
# 출발지를 안 밝혔을 때의 기본값. "집에서 공항까지" 가 되게 한다.
HOME_ADDRESS=

# 카메라 (선택) — `python voice_client/jarvis_vision.py` 로 비전 데몬을 따로 띄운다.
# 얼굴 임베딩 차원은 OpenCV SFace 출력에 맞춘 값이다. 바꾸면 known_faces 를 비워야 한다.
FACE_EMBEDDING_DIM=128
# 사물·장면 설명에 쓸 모델. 비우면 LLM_MODEL 을 그대로 쓴다.
VISION_MODEL=

# 세컨브레인 (선택) — 색인할 노트 폴더. 옵시디언 vault 든 그냥 문서 폴더든 된다.
# 비우면 노트 도구만 안내 문구를 돌려주고 나머지는 정상 동작한다.
NOTES_PATH=
NOTES_EXTENSIONS=.md,.txt,.pdf
NOTES_INDEX_MINUTES=10
NOTES_CHUNK_CHARS=1200

# 도구가 남기는 캡처물(폰 스크린샷 등) 보관 위치
CAPTURES_PATH=captures
# 노트를 읽어 만든 음성 파일 보관 위치
PODCASTS_PATH=podcasts

# Claude Code 연동 — 음성으로 코드 조회·수정 (선택)
# claude CLI 가 설치돼 있어야 하고, 여기 등록한 프로젝트만 열 수 있다.
# 백엔드가 claude 를 실행해야 하므로 Docker 안이 아니라 호스트에서 띄워야 한다(README 참고).
# 말로 부르는 이름이 폴더명과 다르면 `|` 로 별칭을 여러 개 단다.
CODE_PROJECTS=javis|자비스=C:\workspace\Javis
CODE_MODEL=opus
# 응답이 느리면: CODE_MODEL=sonnet

# 음성 데몬 웨이크워드 (openWakeWord, 무료·키 불필요). "헤이 자비스 / hey jarvis"로 깸.
# 끄려면 JAVIS_OWW=0 (그러면 Vosk 방식). 임계값 0~1, 높을수록 엄격(오인식↓, 기본 0.5).
JAVIS_OWW=1
JAVIS_OWW_THRESHOLD=0.5

# 음성 데몬 — 답변 뒤 이만큼(초) 동안은 깨우지 않고 이어 말할 수 있다. 0 이면 끔.
JAVIS_CONV_TIMEOUT=10
# 첫 덩어리를 로컬 음성(SAPI)으로 즉시 내보내 첫 소리까지의 지연을 없앤다. 끄려면 0.
JAVIS_TTS_FIRST_LOCAL=1
# 운전 모드 — 답변을 두세 문장으로 줄인다.
JAVIS_DRIVE=0
